APP_NAME="CCDI Lost and Found"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# php artisan serve  => http://127.0.0.1:8000   |   XAMPP Apache => http://localhost/ccdi_lost_found/public
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Manila

# Maximum photo upload size in KB (30720 = 30 MB). php.ini upload_max_filesize/post_max_size must be >= this.
UPLOAD_MAX_KB=30720

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL / MariaDB through XAMPP. Create the schema by EITHER importing
# database/ccdi_lost_found_database.sql in phpMyAdmin OR running `php artisan migrate`.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ccdi_lost_found
DB_USERNAME=root
# XAMPP's root account has an empty password by default. Create a dedicated MySQL user for anything but local demos.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="lostandfound@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---- Image matching (OpenCV worker: scripts/matcher/match_images.py) ----
# Windows example: MATCHER_PYTHON="C:\Python312\python.exe"   (leave as "python" if it is on PATH)
MATCHER_ENABLED=true
MATCHER_PYTHON=python
MATCHER_TIMEOUT_SECONDS=90
# Acceptance criteria. DEFAULTS ARE STARTING POINTS, NOT VALIDATED VALUES - tune them with your own test photos.
MATCHER_SIFT_RATIO=0.75
MATCHER_SIFT_MIN_INLIERS=12
MATCHER_SIFT_MIN_INLIER_RATIO=0.25
MATCHER_ORB_RATIO=0.75
MATCHER_ORB_MIN_INLIERS=15
MATCHER_ORB_MIN_INLIER_RATIO=0.25
MATCHER_MIN_KEYPOINTS=20

# ---- Workflow ----
# Found reports always wait for administrator review. Set to false to also review LOST reports before they are listed.
REPORTS_AUTO_PUBLISH_LOST=true
